{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://swedr13.github.io/final",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/optimize-images.mjs && node scripts/copy-fonts.mjs",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:preview": "cross-env PREVIEW=1 npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "size": "size-limit",
    "check": "npm run lint && npm test && npm run build && npm run size",
    "deploy": "npm run build && gh-pages -d dist --dotfiles",
    "deploy:preview": "npm run build:preview && gh-pages -d dist --dest preview --add --dotfiles"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@size-limit/file": "14.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.2.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "gh-pages": "6.3.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "sharp": "0.35.5",
    "size-limit": "14.3.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
